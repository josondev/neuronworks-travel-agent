# =============================================================================
# Travel MCP Server — Environment Variables
# Copy this file to .env and fill in your keys.
# =============================================================================

# --- PostgreSQL Database (Required for DB features) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# Render free tier:    add a PostgreSQL addon → copy the "External Database URL"
# Local dev:           postgresql://postgres:password@localhost:5432/travel_mcp
DATABASE_URL=""

# --- Flights + Hotels (SerpApi Google Flights / Google Hotels) ---
# Get from https://serpapi.com/
# Both SERPAPI_API_KEY and SERPAPI_KEY are accepted (server checks both)
SERPAPI_API_KEY=""

# --- Currency Exchange (ExchangeRate-API) ---
# Get from https://www.exchangerate-api.com/
EXCHANGE_API_KEY=""

# --- Weather (OpenWeatherMap) ---
# Get from https://openweathermap.org/api
# WeatherService checks OPENWEATHER_API_KEY first, then OPENWEATHERMAP_API_KEY
OPENWEATHER_API_KEY=""

# --- Places / Geocoding (Geoapify) ---
# Get from https://www.geoapify.com/
GEOAPIFY_API_KEY=""

# --- OpenRouter (Frontend only — set in Streamlit Cloud secrets, not here) ---
# Get from https://openrouter.ai/
# OPENROUTER_API_KEY=""
